<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link href="/styles/style.css" type="text/css" rel="stylesheet" />
    <link href="/styles/Fonts.css" type="text/css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,200..900;1,200..900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Lemon&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="p-7 poppins-regular">
    <header class="">
      <h2 class="text-3xl font-medium text-center py-4">WizInoa Expense Report</h2>
    </header>
    <main class="flex flex-col gap-y-3">
      <h1 class="text-2xl font-semibold text-gray-700">Expenses</h1>
      <p class="text-right text-lg">Date: <%=report_date %></p>
      <table class="w-full border text-center">
        <thead>
          <tr>
            <th class="border py-2">S.No</th>
            <th class="border">Expense Name</th>
            <th class="border">Expense Category</th>
            <th class="border">Amount</th>
            <th class="border">Payment Mode</th>
          </tr>
        </thead>
        <tbody>
          <% expenses.forEach((data,index) => { %>
          <tr>
            <td class="border py-4"><%= index + 1 %></td>
            <td class="border"><%= data.expense_name %></td>
            <td class="border"><%= data.expense_category %></td>
            <td class="border"><%= data.amount || 0 %></td>
            <td class="border"><%= data.payment_mode %></td>
          </tr>
          <% })%>
        </tbody>
      </table>
      
      <% if (amount) { %>
      <div class="flex flex-col items-end p-5">
        <p>Received Amount : <%= amount.received_amount || 0 %> Rs</p>
        <p>Spent Amount : <%= amount.spent_amount || 0 %> Rs</p>
        <p>Pending Amount : <%= amount.pending_amount || 0 %> Rs</p>
      </div>
      <% } %>
    </main>
    <footer class="absolute bottom-0 w-full left-0">
      <p class="text-center py-4 text-xl font-bold">Thank you</p>
    </footer>
  </body>
</html>
