
<!-- Header.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wizinoa Realestate</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f9;padding:40px 0;">
    <tr>
        <td align="center">

            <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.08);">

                <tr>
                    <td style="background:#0f172a;padding:25px;text-align:center;">
                        <h1 style="margin:0;color:#ffffff;font-size:28px;">
                            Wizinoa Realestate
                        </h1>
                    </td>
                </tr>

                <tr>
                    <td style="padding:40px;">

<!-- Main.ejs -->

<h2 style="margin-top:0;color:#1e293b;">
    Hi <%= full_name %> 👋
</h2>

<p style="font-size:16px;color:#555;">
    This is the reminder to login your meta app, in wizinoa realestate site, to track the meta ads lead data.
</p>
<p style="font-size:16px;color:#555;">
