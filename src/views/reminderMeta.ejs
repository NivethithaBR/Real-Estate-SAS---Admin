    Please keep your meta login credentials secure and do not share it with anyone.
</p>



<!-- Footer.ejs -->

                </td>
            </tr>

                <tr>
                    <td style="background:#f8fafc;padding:20px;text-align:center;border-top:1px solid #e5e7eb;">
                        <p style="margin:0;font-size:15px;color:#555;">
                            Thank you ❤️
                        </p>

                        <p style="margin-top:8px;font-size:13px;color:#888;">
